# Shared local-development infrastructure configuration for docker-compose.
# Copy to `.env` and adjust; never commit `.env` with real values.

# Use staging with HTTPS origins/reset URL for staging deployments.
ENV=development

# --- Postgres (shared cluster, one database per service) ---
POSTGRES_USER=shopee
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_PORT=5432
# Per-service database roles (deploy/postgres-init/db-roles.psql): the
# services connect as <service>_app (rows of their own database only), the
# migrations as shopee_migrator; POSTGRES_USER stays the superuser for
# operations only. Letters, digits, _ and - only (they go into URLs);
# generate with deploy/gen-db-passwords.sh. A new volume creates the roles
# itself; an existing cluster: bash deploy/db-roles.sh.
MIGRATOR_DB_PASSWORD=CHANGE_ME
IDENTITY_DB_PASSWORD=CHANGE_ME
VENDOR_DB_PASSWORD=CHANGE_ME
CATALOG_DB_PASSWORD=CHANGE_ME
INVENTORY_DB_PASSWORD=CHANGE_ME
CART_DB_PASSWORD=CHANGE_ME
ORDER_DB_PASSWORD=CHANGE_ME
PAYMENT_DB_PASSWORD=CHANGE_ME
SHIPMENT_DB_PASSWORD=CHANGE_ME
ADMIN_DB_PASSWORD=CHANGE_ME
NOTIFICATION_DB_PASSWORD=CHANGE_ME
REVIEW_DB_PASSWORD=CHANGE_ME

# --- Redis ---
REDIS_PORT=6379

# --- NATS (message broker) ---
NATS_CLIENT_PORT=4222
NATS_MONITOR_PORT=8222

# --- MinIO (S3-compatible object storage, local dev only) ---
MINIO_ROOT_USER=CHANGE_ME
MINIO_ROOT_PASSWORD=CHANGE_ME
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
# Where browsers load images. Production behind Caddy: https://<SITE_DOMAIN>/media
OBJECT_STORAGE_PUBLIC_BASE_URL=http://localhost:9000

# --- Auth (shared across services that verify/issue access tokens) ---
# Random secret, at least 32 characters for staging/production; same across services.
JWT_SECRET=CHANGE_ME

# --- Payment (mock provider until real Stripe/PayPal credentials exist) ---
PAYMENT_PROVIDER=mock
PAYMENT_MOCK_WEBHOOK_SECRET=CHANGE_ME
VENDOR_PAYOUT_ENCRYPTION_KEY=CHANGE_ME
# Dedicated Payment payout scope; at least 32 random characters, different from IDENTITY_SERVICE_KEY.
VENDOR_PAYOUT_SERVICE_KEY=CHANGE_ME
PAYOS_CLIENT_ID=CHANGE_ME
PAYOS_API_KEY=CHANGE_ME
PAYOS_CHECKSUM_KEY=CHANGE_ME
PAYOS_API_URL=https://api-merchant.payos.vn
PAYOS_RETURN_URL=http://localhost:3000/orders/payment-return
PAYOS_CANCEL_URL=http://localhost:3000/orders/payment-cancel
# Webhook deliveries accepted per client IP per minute (10-100000). Over the
# limit the provider gets 429 and retries; every delivery is deduplicated.
PAYMENT_WEBHOOK_RATE_PER_MINUTE=600

# --- Shipment carrier interception (mock adapter until a real carrier is integrated) ---
# manual (default, production): tracking entered by vendors/admins.
# mock: simulated carrier for local testing only (refused in production);
# needs SHIPMENT_CARRIER_MOCK_WEBHOOK_SECRET.
SHIPMENT_CARRIER_PROVIDER=manual
SHIPMENT_CARRIER_MOCK_WEBHOOK_SECRET=CHANGE_ME
# Days a delivered/cancelled/returned shipment keeps the buyer's name, phone
# and street (0 keeps them; otherwise 30-3650). Order keeps its own copy.
SHIPMENT_ADDRESS_RETENTION_DAYS=180

# --- Admin dashboard and audit search (read-only, no extra secret) ---
# Set ADMIN_REVIEW_SERVICE_URL to empty when reviews are disabled.
ADMIN_REVIEW_SERVICE_URL=http://review:8091
# true also lists reviews that are not verified purchases (seeded demo data,
# local/staging only). Refused when ENV=production.
REVIEW_SHOW_UNVERIFIED=false
# Bound on each read from a service (500ms-30s).
ADMIN_UPSTREAM_TIMEOUT=4s

# --- API Gateway ---
GATEWAY_PORT=8080
# Production behind Caddy: https://<SITE_DOMAIN>
ALLOWED_ORIGINS=http://localhost:3000

# --- Frontend ---
FRONTEND_PORT=3000
# Public gateway origin, WITHOUT /api; baked into the frontend image at build time.
# Staging example: https://staging.example.invalid (reverse proxy routes /api to gateway).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# Immediate session revocation; required for authenticated services
# Host-run service URL only; Compose supplies http://identity:8081 internally.
IDENTITY_SERVICE_URL=http://localhost:8081
# Former shared service key (at least 32 characters). Local development only,
# or during the switch to per-service keys with INTERNAL_AUTH_ACCEPT_SHARED_KEY=true.
IDENTITY_SERVICE_KEY=CHANGE_ME

# PLT-01 per-service identity: generate with `bash deploy/gen-service-keys.sh`
# (prints these lines). Each service gets only its own key; every service
# gets the registry of key hashes (not secret). Required in production.
IDENTITY_INTERNAL_KEY=CHANGE_ME
VENDOR_INTERNAL_KEY=CHANGE_ME
CATALOG_INTERNAL_KEY=CHANGE_ME
INVENTORY_INTERNAL_KEY=CHANGE_ME
CART_INTERNAL_KEY=CHANGE_ME
ORDER_INTERNAL_KEY=CHANGE_ME
PAYMENT_INTERNAL_KEY=CHANGE_ME
SHIPMENT_INTERNAL_KEY=CHANGE_ME
ADMIN_INTERNAL_KEY=CHANGE_ME
REVIEW_INTERNAL_KEY=CHANGE_ME
NOTIFICATION_INTERNAL_KEY=CHANGE_ME
# name=sha256(key)[|old hash during a rotation], comma separated.
INTERNAL_SERVICE_KEYS=CHANGE_ME
# true only while switching from the shared key (all services restarted).
INTERNAL_AUTH_ACCEPT_SHARED_KEY=false

# PLT-03: how producers deliver domain events: jetstream (default) or http (rollback only).
EVENT_PUBLISHING=jetstream
# Event bus login: each service connects to NATS as its own name with its
# <SERVICE>_INTERNAL_KEY (IDENTITY_SERVICE_KEY when unset); Compose gives the
# broker (deploy/nats/nats.conf) and the service the same value. Set it only
# for a service run outside Compose; production requires at least 32 characters.
EVENTBUS_PASSWORD=
# PLT-01: published ports listen on loopback only. In production nothing
# but the edge proxy (deploy/compose.edge.yml) is public; Docker bypasses
# ufw, so never set these to 0.0.0.0 on a server (bash deploy/check-exposure.sh).
INTERNAL_BIND_ADDRESS=127.0.0.1
# Gateway and frontend; 0.0.0.0 only to reach a local stack from another device.
PUBLIC_BIND_ADDRESS=127.0.0.1

# --- Edge proxy (production) ---
# On the server, uncomment so every "docker compose" command includes the edge
# override (otherwise a plain "up -d" takes the gateway off the edge network).
# COMPOSE_FILE=docker-compose.yml:deploy/compose.edge.yml
# Public hostname Caddy serves and gets a TLS certificate for (DNS must point here).
SITE_DOMAIN=shop.example.invalid
# Contact address for the certificate authority (expiry notices).
ACME_EMAIL=ops@example.invalid
# Private network between Caddy and the gateway/frontend/MinIO, and Caddy's
# fixed address in it (the only address the gateway trusts X-Forwarded-For from).
# Change both together if the range is taken on the host.
EDGE_SUBNET=192.168.250.0/28
EDGE_PROXY_IP=192.168.250.10

# Standard Base64 encoding of exactly 32 random bytes; Identity only.
IDENTITY_RESET_ENCRYPTION_KEY=CHANGE_ME
# Separate random secret, at least 32 characters; Identity + Notification only.
# Must differ from IDENTITY_SERVICE_KEY.
IDENTITY_RESET_DELIVERY_KEY=CHANGE_ME
# Empty inherits ALLOWED_ORIGINS in Compose. Use exact HTTPS frontend origins in staging.
# Comma-separated, no trailing slash or wildcard.
IDENTITY_ALLOWED_ORIGINS=
# Staging example: https://staging.example.invalid/reset-password; no query/fragment.
IDENTITY_PASSWORD_RESET_URL=http://localhost:3000/reset-password
# Optional one-time operator command; never consumed by server startup
IDENTITY_BOOTSTRAP_CONFIRM=false
IDENTITY_BOOTSTRAP_EMAIL=admin@example.invalid
IDENTITY_BOOTSTRAP_NAME=Marketplace Admin
IDENTITY_BOOTSTRAP_PASSWORD=CHANGE_ME
IDENTITY_BOOTSTRAP_OPERATOR=operator-reference


VENDOR_PAYOUT_ENCRYPTION_KEY=CHANGE_ME
VENDOR_PAYOUT_SERVICE_KEY=CHANGE_ME
# Password-reset email delivery; configure a staging mailbox/provider with STARTTLS.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=CHANGE_ME
SMTP_PASSWORD=CHANGE_ME
SMTP_FROM=no-reply@example.invalid
SMTP_ALLOW_PLAINTEXT=false
# Notification email: smtp or mock (local only, refused in production).
# Empty: smtp when SMTP_HOST is set, otherwise mock.
NOTIFICATION_EMAIL_PROVIDER=
# Days of delivery-attempt history kept (0 keeps it; otherwise 7-3650).
NOTIFICATION_ATTEMPT_RETENTION_DAYS=90
# true stops sending; requests are still recorded and sent on resume.
NOTIFICATION_DELIVERY_PAUSED=false
# Delivery jobs run at once by the Asynq workers (queue on REDIS_URL), 1-100.
NOTIFICATION_WORKER_CONCURRENCY=10

# Set exact gateway network CIDRs in deployment; no wildcard trust
# Replace the local-development range below with the actual gateway CIDR in staging.
IDENTITY_TRUSTED_PROXY_CIDRS=172.16.0.0/12
# Actual TLS reverse-proxy CIDRs; empty means gateway trusts no forwarded client IP.
# Required in production; compose.edge.yml sets it to EDGE_PROXY_IP.
GATEWAY_TRUSTED_PROXY_CIDRS=

# Enable only after Inventory receipt consumers and legacy reconciliation are deployed.
INVENTORY_EXPIRY_ENABLED=false

# --- Cart retention ---
# Idle carts (no change for N days) are deleted; carts with an unconsumed checkout
# operation are always kept. Minimum 30 days each; operation retention must stay
# longer than Order's cart-consume retry horizon (about 9 hours).
CART_RETENTION_ENABLED=true
CART_RETENTION_DAYS=180
CART_OPERATION_RETENTION_DAYS=90

# --- Order returns ---
# Days after a vendor order is completed during which the buyer may ask for a
# return (1-365). Each return stores the policy version it was accepted under.
ORDER_RETURN_WINDOW_DAYS=7

# inventory service configuration
ENV=development
PORT=8084
LOG_LEVEL=info
DATABASE_URL=postgres://shopee:CHANGE_ME@localhost:5432/inventory_db?sslmode=disable
REDIS_URL=redis://localhost:6379/0
NATS_URL=nats://localhost:4222
JWT_SECRET=CHANGE_ME
VENDOR_SERVICE_URL=http://localhost:8082
CATALOG_SERVICE_URL=http://localhost:8083
# Reconciliation reads order status and delivers ReservationExpired events here.
ORDER_SERVICE_URL=http://localhost:8086
# Keep false until Order's inventory-event consumer is deployed and legacy holds are reviewed.
INVENTORY_EXPIRY_ENABLED=false
# PW-027: restock requests of at least this many units need two admins (0: off).
INVENTORY_RESTOCK_SECOND_APPROVAL_QUANTITY=0
SHUTDOWN_TIMEOUT=10
HTTP_READ_TIMEOUT=5
HTTP_IDLE_TIMEOUT=60

# Immediate session revocation
IDENTITY_SERVICE_URL=http://localhost:8081
IDENTITY_SERVICE_KEY=CHANGE_ME

# AF-13: enable only after shop policies and Notification are ready.
FEATURE_STOCK_SELF_SERVICE_ENABLED=false
NOTIFICATION_SERVICE_URL=http://notification:8090

# AF-16: bulk CSV imports/exports. Stock receipts also need FEATURE_STOCK_SELF_SERVICE_ENABLED.
FEATURE_BULK_OPERATIONS_ENABLED=false
IMPORT_MAX_ROWS=1000
IMPORT_MAX_BYTES=5242880
# Private bucket (never the public media bucket); empty disables uploads.
IMPORT_STORAGE_ENDPOINT=
IMPORT_STORAGE_BUCKET=inventory-imports
IMPORT_STORAGE_USE_SSL=false
IMPORT_STORAGE_DOWNLOAD_ORIGIN=
IMPORT_STORAGE_ACCESS_KEY=CHANGE_ME
IMPORT_STORAGE_SECRET_KEY=CHANGE_ME

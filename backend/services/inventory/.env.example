# inventory service configuration
ENV=development
PORT=8084
LOG_LEVEL=info
DATABASE_URL=postgres://shopee:CHANGE_ME@localhost:5432/inventory_db?sslmode=disable
REDIS_URL=redis://localhost:6379/0
NATS_URL=nats://localhost:4222
JWT_SECRET=CHANGE_ME
VENDOR_SERVICE_URL=http://localhost:8082
CATALOG_SERVICE_URL=http://localhost:8083
# Reconciliation reads order status and delivers ReservationExpired events here.
ORDER_SERVICE_URL=http://localhost:8086
# Keep false until Order's inventory-event consumer is deployed and legacy holds are reviewed.
INVENTORY_EXPIRY_ENABLED=false
# PW-027: restock requests of at least this many units need two admins (0: off).
INVENTORY_RESTOCK_SECOND_APPROVAL_QUANTITY=0
SHUTDOWN_TIMEOUT=10
HTTP_READ_TIMEOUT=5
HTTP_IDLE_TIMEOUT=60

# Immediate session revocation
IDENTITY_SERVICE_URL=http://localhost:8081
IDENTITY_SERVICE_KEY=CHANGE_ME

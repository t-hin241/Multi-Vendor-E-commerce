# cart service configuration
ENV=development
PORT=8085
LOG_LEVEL=info
DATABASE_URL=postgres://shopee:CHANGE_ME@localhost:5432/cart_db?sslmode=disable
REDIS_URL=redis://localhost:6379/0
NATS_URL=nats://localhost:4222
JWT_SECRET=CHANGE_ME
CATALOG_SERVICE_URL=http://localhost:8083
# Display-only stock warnings in the cart; checkout still reserves in Inventory.
INVENTORY_SERVICE_URL=http://localhost:8084
SHUTDOWN_TIMEOUT=10
HTTP_READ_TIMEOUT=5
HTTP_IDLE_TIMEOUT=60

# Immediate session revocation
IDENTITY_SERVICE_URL=http://localhost:8081
IDENTITY_SERVICE_KEY=CHANGE_ME

# Cart retention (days, minimum 30). Carts with an unconsumed checkout operation are never purged.
CART_RETENTION_ENABLED=true
CART_RETENTION_DAYS=180
CART_OPERATION_RETENTION_DAYS=90
CART_RETENTION_INTERVAL_MINUTES=60

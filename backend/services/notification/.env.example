# notification service configuration
ENV=development
PORT=8090
LOG_LEVEL=info
DATABASE_URL=postgres://shopee:CHANGE_ME@localhost:5432/notification_db?sslmode=disable
REDIS_URL=redis://localhost:6379/0
NATS_URL=nats://localhost:4222
JWT_SECRET=CHANGE_ME
IDENTITY_SERVICE_URL=http://localhost:8081
SHUTDOWN_TIMEOUT=10
HTTP_READ_TIMEOUT=5
HTTP_IDLE_TIMEOUT=60

# Immediate session revocation
IDENTITY_SERVICE_KEY=CHANGE_ME

IDENTITY_RESET_DELIVERY_KEY=CHANGE_ME
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=CHANGE_ME
SMTP_PASSWORD=CHANGE_ME
SMTP_FROM=no-reply@example.invalid
SMTP_ALLOW_PLAINTEXT=false

# smtp (needs SMTP_HOST and SMTP_FROM) or mock (local only; refused when
# ENV=production). Empty: smtp when SMTP_HOST is set, otherwise mock.
NOTIFICATION_EMAIL_PROVIDER=
# Days of delivery-attempt history kept (0 keeps it; otherwise 7-3650).
NOTIFICATION_ATTEMPT_RETENTION_DAYS=90
# true stops sending (requests are still recorded and sent on resume).
NOTIFICATION_DELIVERY_PAUSED=false
# Delivery jobs run at once by the Asynq workers (queue on REDIS_URL), 1-100.
NOTIFICATION_WORKER_CONCURRENCY=10
# AF-08 shop work notices: record order/payment work events, ask Vendor who
# may receive them, email the owner and opted-in staff. Needs VENDOR_SERVICE_URL.
FEATURE_VENDOR_ACTION_NOTICES_ENABLED=false
VENDOR_SERVICE_URL=http://localhost:8082
# AF-09 inbox: new notices also go to the person's inbox; kept 7-3650 days.
FEATURE_NOTIFICATION_INBOX_ENABLED=false
INBOX_RETENTION_DAYS=90

# AF-07 (PW-045): shop notices nobody received become admin work items;
# shadow by default, IDs must name active admins before sending.
FEATURE_CASE_SLA_ENABLED=false
SLA_POLL_INTERVAL=60s
SLA_ON_CALL_ADMIN_IDS=
SLA_ESCALATION_ADMIN_IDS=

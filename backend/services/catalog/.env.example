# catalog service configuration
FEATURE_VARIANT_PRICING_ENABLED=false
ENV=development
PORT=8083
LOG_LEVEL=info
DATABASE_URL=postgres://shopee:CHANGE_ME@localhost:5432/catalog_db?sslmode=disable
REDIS_URL=redis://localhost:6379/0
NATS_URL=nats://localhost:4222
JWT_SECRET=CHANGE_ME
VENDOR_SERVICE_URL=http://localhost:8082
OBJECT_STORAGE_ENDPOINT=localhost:9000
OBJECT_STORAGE_ACCESS_KEY=CHANGE_ME
OBJECT_STORAGE_SECRET_KEY=CHANGE_ME
OBJECT_STORAGE_USE_SSL=false
OBJECT_STORAGE_BUCKET=product-images
OBJECT_STORAGE_PUBLIC_BASE_URL=http://localhost:9000
SHUTDOWN_TIMEOUT=10
HTTP_READ_TIMEOUT=5
HTTP_IDLE_TIMEOUT=60

# Immediate session revocation
IDENTITY_SERVICE_URL=http://localhost:8081
IDENTITY_SERVICE_KEY=CHANGE_ME

# AF-16: bulk CSV imports/exports.
FEATURE_BULK_OPERATIONS_ENABLED=false
IMPORT_MAX_ROWS=1000
IMPORT_MAX_BYTES=5242880
# Private bucket (never the public media bucket); empty disables uploads.
IMPORT_STORAGE_ENDPOINT=
IMPORT_STORAGE_BUCKET=catalog-imports
IMPORT_STORAGE_USE_SSL=false
IMPORT_STORAGE_DOWNLOAD_ORIGIN=
IMPORT_STORAGE_ACCESS_KEY=CHANGE_ME
IMPORT_STORAGE_SECRET_KEY=CHANGE_ME

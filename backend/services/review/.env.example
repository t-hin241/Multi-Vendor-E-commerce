PORT=8091
DATABASE_URL=postgres://CHANGE_ME
JWT_SECRET=CHANGE_ME
ORDER_SERVICE_URL=http://order:8086
VENDOR_SERVICE_URL=http://vendor:8082
IDENTITY_SERVICE_URL=http://identity:8081
OBJECT_STORAGE_ENDPOINT=minio:9000
OBJECT_STORAGE_ACCESS_KEY=CHANGE_ME
OBJECT_STORAGE_SECRET_KEY=CHANGE_ME
OBJECT_STORAGE_USE_SSL=false
OBJECT_STORAGE_BUCKET=review-images
OBJECT_STORAGE_PUBLIC_BASE_URL=http://localhost:9000
# true also lists reviews that are not verified purchases (seeded demo data,
# local/staging only). Refused when ENV=production.
REVIEW_SHOW_UNVERIFIED=false

# Internal calls (Order eligibility, Vendor ownership, Identity names, admin
# re-verification) and immediate session revocation
IDENTITY_SERVICE_KEY=CHANGE_ME

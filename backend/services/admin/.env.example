# admin service configuration
ENV=development
PORT=8089
LOG_LEVEL=info
DATABASE_URL=postgres://shopee:CHANGE_ME@localhost:5432/admin_db?sslmode=disable
REDIS_URL=redis://localhost:6379/0
NATS_URL=nats://localhost:4222
SHUTDOWN_TIMEOUT=10
HTTP_READ_TIMEOUT=5
HTTP_IDLE_TIMEOUT=60

JWT_SECRET=CHANGE_ME

# Immediate session revocation and admin re-verification
IDENTITY_SERVICE_URL=http://localhost:8081
IDENTITY_SERVICE_KEY=CHANGE_ME

# Read-only operations dashboard and audit search: Admin forwards the
# signed-in admin's own token to these services (no extra secret).
VENDOR_SERVICE_URL=http://localhost:8082
CATALOG_SERVICE_URL=http://localhost:8083
INVENTORY_SERVICE_URL=http://localhost:8084
ORDER_SERVICE_URL=http://localhost:8086
PAYMENT_SERVICE_URL=http://localhost:8087
SHIPMENT_SERVICE_URL=http://localhost:8088
NOTIFICATION_SERVICE_URL=http://localhost:8090
# Optional: leave empty when reviews are disabled.
REVIEW_SERVICE_URL=http://localhost:8091
# Bound on each read from a service (500ms-30s).
ADMIN_UPSTREAM_TIMEOUT=4s

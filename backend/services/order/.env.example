# order service configuration
ENV=development
PORT=8086
LOG_LEVEL=info
DATABASE_URL=postgres://shopee:CHANGE_ME@localhost:5432/order_db?sslmode=disable
REDIS_URL=redis://localhost:6379/0
NATS_URL=nats://localhost:4222
JWT_SECRET=CHANGE_ME
CART_SERVICE_URL=http://localhost:8085
CATALOG_SERVICE_URL=http://localhost:8083
VENDOR_SERVICE_URL=http://localhost:8082
INVENTORY_SERVICE_URL=http://localhost:8084
SHIPMENT_SERVICE_URL=http://localhost:8088
NOTIFICATION_SERVICE_URL=http://localhost:8090
# Order requests refunds from Payment; Payment reports outcomes back.
PAYMENT_SERVICE_URL=http://localhost:8087
# Return window after completion, 1-365 days.
ORDER_RETURN_WINDOW_DAYS=7
# Support cases (AF-01): false only stops new cases.
FEATURE_ORDER_SUPPORT_ENABLED=false
# Optional comma-separated pilot vendor ids; empty = every shop.
FEATURE_ORDER_SUPPORT_PILOT_VENDOR_IDS=
SUPPORT_ATTACHMENT_RETENTION_DAYS=180
# PW-001: money cases hold the payout in Payment's ledger (root .env.example).
FEATURE_SETTLEMENT_HOLD_LEDGER_ENABLED=false
# AF-03: cancellation of paid packages before handover (root .env.example).
FEATURE_PAID_CANCELLATION_ENABLED=false
# AF-04: offer redeliveries of failed packages (root .env.example).
FEATURE_DELIVERY_RESOLUTION_ENABLED=false
# Private evidence bucket (must have no bucket policy). Leave the endpoint
# empty to run without attachments.
SUPPORT_ATTACHMENT_STORAGE_ENDPOINT=localhost:9000
SUPPORT_ATTACHMENT_STORAGE_ACCESS_KEY=CHANGE_ME
SUPPORT_ATTACHMENT_STORAGE_SECRET_KEY=CHANGE_ME
SUPPORT_ATTACHMENT_STORAGE_USE_SSL=false
SUPPORT_ATTACHMENT_BUCKET=support-evidence
SHUTDOWN_TIMEOUT=10
HTTP_READ_TIMEOUT=5
HTTP_IDLE_TIMEOUT=60

# Immediate session revocation
IDENTITY_SERVICE_URL=http://localhost:8081
IDENTITY_SERVICE_KEY=CHANGE_ME
# Versioned policies (AF-02); same value in Vendor and Order.
FEATURE_VERSIONED_POLICIES_ENABLED=false

# AF-07: shadow by default; IDs must name active admins before sending.
FEATURE_CASE_SLA_ENABLED=false
SLA_POLL_INTERVAL=60s
SLA_ON_CALL_ADMIN_IDS=
SLA_ESCALATION_ADMIN_IDS=

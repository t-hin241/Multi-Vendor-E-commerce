# identity service configuration
ENV=development
PORT=8081
LOG_LEVEL=info
DATABASE_URL=postgres://shopee:CHANGE_ME@localhost:5432/identity_db?sslmode=disable
REDIS_URL=redis://localhost:6379/0
NATS_URL=nats://localhost:4222
JWT_SECRET=CHANGE_ME
SHUTDOWN_TIMEOUT=10
HTTP_READ_TIMEOUT=5
HTTP_IDLE_TIMEOUT=60

# Immediate session revocation
IDENTITY_SERVICE_URL=http://localhost:8081
IDENTITY_SERVICE_KEY=CHANGE_ME

IDENTITY_RESET_ENCRYPTION_KEY=CHANGE_ME
IDENTITY_RESET_DELIVERY_KEY=CHANGE_ME
IDENTITY_ALLOWED_ORIGINS=http://localhost:3000
IDENTITY_PASSWORD_RESET_URL=http://localhost:3000/reset-password
# PW-022: email verification links (Identity) and the page they open.
FEATURE_EMAIL_VERIFICATION_ENABLED=false
IDENTITY_EMAIL_VERIFY_URL=http://localhost:3000/verify-email
# PW-028: base64 of 32 random bytes sealing admin authenticator secrets
# (set from the secret store; CHANGE_ME turns enrollment off).
IDENTITY_MFA_ENCRYPTION_KEY=CHANGE_ME
FEATURE_ADMIN_MFA_REQUIRED=false
NOTIFICATION_SERVICE_URL=http://localhost:8090
# Bootstrap admin command configuration
IDENTITY_BOOTSTRAP_CONFIRM=false
IDENTITY_BOOTSTRAP_EMAIL=admin@example.invalid
IDENTITY_BOOTSTRAP_NAME=Marketplace Admin
IDENTITY_BOOTSTRAP_PASSWORD=CHANGE_ME
IDENTITY_BOOTSTRAP_OPERATOR=operator-reference

# Gateway proxy CIDRs
IDENTITY_TRUSTED_PROXY_CIDRS=172.16.0.0/12
# Scoped admin permissions (AF-19); see the root .env.example.
FEATURE_ADMIN_SCOPED_PERMISSIONS_ENABLED=false

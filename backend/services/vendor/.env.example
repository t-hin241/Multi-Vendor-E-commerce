# vendor service configuration
ENV=development
PORT=8082
LOG_LEVEL=info
DATABASE_URL=postgres://shopee:CHANGE_ME@localhost:5432/vendor_db?sslmode=disable
REDIS_URL=redis://localhost:6379/0
NATS_URL=nats://localhost:4222
JWT_SECRET=CHANGE_ME
VENDOR_PAYOUT_ENCRYPTION_KEY=CHANGE_ME
# Dedicated Payment payout scope; at least 32 random characters, different from IDENTITY_SERVICE_KEY.
VENDOR_PAYOUT_SERVICE_KEY=CHANGE_ME
CATALOG_SERVICE_URL=http://localhost:8083
ORDER_SERVICE_URL=http://localhost:8086
PAYMENT_SERVICE_URL=http://localhost:8087
NOTIFICATION_SERVICE_URL=http://localhost:8090
SHUTDOWN_TIMEOUT=10
HTTP_READ_TIMEOUT=5
HTTP_IDLE_TIMEOUT=60

# Immediate session revocation
IDENTITY_SERVICE_URL=http://localhost:8081
IDENTITY_SERVICE_KEY=CHANGE_ME
# Versioned policies (AF-02); same value in Vendor and Order.
FEATURE_VERSIONED_POLICIES_ENABLED=false
# Shop staff (AF-17); off = owner-only. Key/URL required once enabled.
FEATURE_SHOP_STAFF_ENABLED=false
SHOP_STAFF_INVITES_PAUSED=false
STAFF_INVITATION_FINGERPRINT_KEY=CHANGE_ME
STAFF_INVITATION_ACCEPT_URL=http://localhost:3000/staff-invitations/accept

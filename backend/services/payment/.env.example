# payment service configuration
ENV=development
PORT=8087
LOG_LEVEL=info
DATABASE_URL=postgres://shopee:CHANGE_ME@localhost:5432/payment_db?sslmode=disable
REDIS_URL=redis://localhost:6379/0
NATS_URL=nats://localhost:4222
JWT_SECRET=CHANGE_ME
ORDER_SERVICE_URL=http://localhost:8086
# Masked verified payout destinations for manual payout batches.
VENDOR_SERVICE_URL=http://localhost:8082
# Notices over HTTP while the event bus is off (EVENT_PUBLISHING=http).
NOTIFICATION_SERVICE_URL=http://localhost:8090
PAYMENT_WEBHOOK_RATE_PER_MINUTE=600
# PW-032: reimbursements outside a capture; cap per reimbursement (minor units).
FEATURE_REIMBURSEMENTS_ENABLED=false
PAYMENT_REIMBURSEMENT_MAX_AMOUNT=500000
PAYMENT_PROVIDER=mock
PAYMENT_MOCK_WEBHOOK_SECRET=CHANGE_ME
PAYOS_CLIENT_ID=CHANGE_ME
PAYOS_API_KEY=CHANGE_ME
PAYOS_CHECKSUM_KEY=CHANGE_ME
PAYOS_API_URL=https://api-merchant.payos.vn
PAYOS_RETURN_URL=http://localhost:3000/orders/payment-return
PAYOS_CANCEL_URL=http://localhost:3000/orders/payment-cancel
SHUTDOWN_TIMEOUT=10
HTTP_READ_TIMEOUT=5
HTTP_IDLE_TIMEOUT=60

# Immediate session revocation
IDENTITY_SERVICE_URL=http://localhost:8081
IDENTITY_SERVICE_KEY=CHANGE_ME

# AF-07: shadow by default; IDs must name active admins before sending.
FEATURE_CASE_SLA_ENABLED=false
SLA_POLL_INTERVAL=60s
SLA_ON_CALL_ADMIN_IDS=
SLA_ESCALATION_ADMIN_IDS=
# Scoped admin permissions (AF-19); see the root .env.example.
FEATURE_ADMIN_SCOPED_PERMISSIONS_ENABLED=false
# AF-06 manual refund transfers; see the root .env.example.
FEATURE_MANUAL_REFUND_WORKFLOW_ENABLED=false
# AF-08: tell shops their payout results (needs the event bus; after
# Notification's flag).
FEATURE_VENDOR_ACTION_NOTICES_ENABLED=false
# PW-001: off = payout batches rely on the hold ledger only (see the root .env.example).
SETTLEMENT_ORDER_HOLD_QUERY=on
REFUND_DESTINATION_KEY=CHANGE_ME
REFUND_DESTINATION_KEY_VERSION=1
REFUND_DESTINATION_PREVIOUS_KEYS=
MANUAL_REFUND_CLAIM_LEASE_MINUTES=30
# Private bucket for transfer receipts; empty endpoint = no evidence uploads.
REFUND_EVIDENCE_STORAGE_ENDPOINT=
REFUND_EVIDENCE_STORAGE_ACCESS_KEY=CHANGE_ME
REFUND_EVIDENCE_STORAGE_SECRET_KEY=CHANGE_ME
REFUND_EVIDENCE_STORAGE_USE_SSL=false
REFUND_EVIDENCE_BUCKET=refund-evidence
# PW-027: one admin creates a payout batch, another approves it before any
# transfer result is recorded. A second, distinct approver is needed when
# the batch total or one item exceeds these limits (minor units of
# PAYMENT_PAYOUT_APPROVAL_CURRENCY, 0 = no limit), when a destination is
# paid for the first time, or for a batch in another currency.
FEATURE_PAYOUT_BATCH_APPROVAL_ENABLED=true
PAYMENT_PAYOUT_APPROVAL_CURRENCY=VND
PAYMENT_PAYOUT_BATCH_SECOND_APPROVAL_AMOUNT=100000000
PAYMENT_PAYOUT_ITEM_SECOND_APPROVAL_AMOUNT=50000000

# AF-14: new statements/exports off by default; existing downloads remain authorized.
FEATURE_VENDOR_STATEMENTS_ENABLED=false
EXPORT_RETENTION_HOURS=24
STATEMENT_STORAGE_ENDPOINT=
STATEMENT_STORAGE_BUCKET=vendor-statements
STATEMENT_STORAGE_USE_SSL=false
STATEMENT_STORAGE_DOWNLOAD_ORIGIN=
STATEMENT_STORAGE_ACCESS_KEY=CHANGE_ME
STATEMENT_STORAGE_SECRET_KEY=CHANGE_ME

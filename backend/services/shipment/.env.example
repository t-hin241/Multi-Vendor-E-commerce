# shipment service configuration
ENV=development
PORT=8088
LOG_LEVEL=info
DATABASE_URL=postgres://shopee:CHANGE_ME@localhost:5432/shipment_db?sslmode=disable
REDIS_URL=redis://localhost:6379/0
NATS_URL=nats://localhost:4222
JWT_SECRET=CHANGE_ME
VENDOR_SERVICE_URL=http://localhost:8082
ORDER_SERVICE_URL=http://localhost:8086
# manual (default, production): tracking entered by vendors/admins.
# mock: simulated carrier for local testing only (refused in production);
# needs SHIPMENT_CARRIER_MOCK_WEBHOOK_SECRET.
SHIPMENT_CARRIER_PROVIDER=manual
SHIPMENT_CARRIER_MOCK_WEBHOOK_SECRET=CHANGE_ME
# Days a delivered/cancelled/returned shipment keeps the buyer's name, phone
# and street (0 keeps them; otherwise 30-3650). Order keeps its own copy.
SHIPMENT_ADDRESS_RETENTION_DAYS=180
SHUTDOWN_TIMEOUT=10
HTTP_READ_TIMEOUT=5
HTTP_IDLE_TIMEOUT=60

# Immediate session revocation
IDENTITY_SERVICE_URL=http://localhost:8081
IDENTITY_SERVICE_KEY=CHANGE_ME

# AF-07: shadow by default; IDs must name active admins before sending.
FEATURE_CASE_SLA_ENABLED=false
SLA_POLL_INTERVAL=60s
SLA_ON_CALL_ADMIN_IDS=
SLA_ESCALATION_ADMIN_IDS=

# AF-04: report failed deliveries to Order, failure reports, redeliveries.
FEATURE_DELIVERY_RESOLUTION_ENABLED=false
SHIPMENT_DELIVERY_ATTEMPT_LIMIT=2
# AF-05: open return parcels Order authorizes.
FEATURE_RETURN_SHIPPING_ENABLED=false

# Shell scripts run inside Linux containers and on the VPS; CRLF breaks them.
*.sh text eol=lf
# psql scripts: a CR would end up inside \set values.
*.psql text eol=lf
# sqlc input and output: deploy/sqlc.sh diff compares generated code byte
# for byte, so it must not depend on the checkout's line endings.
backend/services/*/sqlc.yaml text eol=lf
backend/services/*/internal/repository/queries/*.sql text eol=lf
backend/services/*/internal/repository/*db/*.go text eol=lf
# NATS config is mounted into a Linux container and parsed by
# pkg/eventbus/natsconf_test.go, which expects LF.
deploy/nats/nats.conf text eol=lf

*.go   text eol=lf
go.mod text eol=lf
go.sum text eol=lf